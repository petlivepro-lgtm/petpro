# Copie para .env e preencha os 3 valores.

# URL do painel do petshop (pro-web) — de onde o gateway valida tokens e
# para onde envia as gravações.
APP_URL=

# Token do Cloudflare Tunnel (Zero Trust → Networks → Tunnels → seu tunnel).
TUNNEL_TOKEN=

# Token gerado no painel em Configurações → Câmeras → Gateway
# ("Salvar e gerar token" — copie na hora, ele aparece uma única vez).
GATEWAY_UPLOAD_TOKEN=
